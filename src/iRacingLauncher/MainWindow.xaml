<ui:FluentWindow x:Class="iRacingLauncher.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:iRacingLauncher.Controls"
                  Title="iRacing Launcher" Height="480" Width="520"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowStartupLocation="CenterScreen"
                  StateChanged="FluentWindow_StateChanged">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="iRacing Launcher">
            <ui:TitleBar.Header>
                <TextBlock Text="iRacing Launcher" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Margin="16,8">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AppRow ViewModel="{Binding}"
                                          StartRequested="AppRow_StartRequested"
                                          StopRequested="AppRow_StopRequested" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="16">
            <ui:Button Content="Settings" Icon="Settings20" Margin="0,0,8,0" Click="SettingsButton_Click" />
            <ui:Button x:Name="LaunchButton" Content="Launch Selected" Icon="Play20"
                       Appearance="Primary" HorizontalAlignment="Stretch"
                       Width="320" Click="LaunchButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
