<ui:FluentWindow x:Class="iRacingLauncher.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:iRacingLauncher.Controls"
                  Title="Sim Racing Launcher" Height="480" Width="520"
                  Icon="pack://application:,,,/Assets/SimRacingLauncher.ico"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowStartupLocation="CenterScreen"
                  StateChanged="FluentWindow_StateChanged">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sim Racing Launcher">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleBarIcon" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock Text="Sim Racing Launcher" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
            <ComboBox x:Name="ProfileComboBox" Grid.Column="1" HorizontalAlignment="Stretch" />
        </Grid>

        <ui:InfoBar x:Name="LaunchInfoBar" Grid.Row="2" Margin="16,8,16,0"
                    IsOpen="False" Severity="Warning" Title="Some apps didn't launch" />

        <ScrollViewer Grid.Row="3" Margin="16,8">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AppRow ViewModel="{Binding}"
                                          StartRequested="AppRow_StartRequested"
                                          StopRequested="AppRow_StopRequested" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Width="36" Height="36" Icon="{ui:SymbolIcon Settings20, FontSize=16}"
                       HorizontalContentAlignment="Center" Margin="0,0,8,0"
                       ToolTip="Settings" Click="SettingsButton_Click" />
            <ui:Button x:Name="LaunchButton" Grid.Column="1" Content="Launch Selected" Icon="Play20"
                       Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       Click="LaunchButton_Click" />
            <ui:Button x:Name="StopAllButton" Grid.Column="2" Content="Stop All" Icon="{ui:SymbolIcon Stop20}"
                       Appearance="Danger" Margin="8,0,0,0" Click="StopAllButton_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
