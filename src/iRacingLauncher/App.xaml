<Application x:Class="iRacingLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:iRacingLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- The launcher's blue: only for selected cells and the main action
                 buttons (Save, Launch Selected). Everything else stays grey. -->
            <SolidColorBrush x:Key="SelectBlue" Color="#4CC2FF" />
            <SolidColorBrush x:Key="SelectBlueHover" Color="#6BCEFF" />
            <SolidColorBrush x:Key="SelectBluePressed" Color="#3AA8E0" />
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
