<ui:FluentWindow x:Class="iRacingLauncher.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Settings" Height="640" Width="860" MinWidth="760"
                  Icon="pack://application:,,,/Assets/SimRacingLauncher.ico"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Blue is only for the selected cell and the Save button; everything else
             keeps the app's normal grey look. -->
        <SolidColorBrush x:Key="SelectBlue" Color="#4CC2FF" />
        <SolidColorBrush x:Key="SelectBlueHover" Color="#6BCEFF" />
        <SolidColorBrush x:Key="SelectBluePressed" Color="#3AA8E0" />

        <!-- Each game/app is its own cell: a rounded tile with a gap below it,
             and a blue bar plus blue tint when selected. -->
        <Style x:Key="CellItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Tile" CornerRadius="6" MinHeight="40"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Border x:Name="Tint" CornerRadius="6" Opacity="0"
                                    Background="{StaticResource SelectBlue}" />
                            <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,7" HorizontalAlignment="Left"
                                    Background="{StaticResource SelectBlue}" Visibility="Collapsed" />
                            <ContentPresenter Margin="14,6,8,6" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs: dimmed text, and a blue underline under the selected one. -->
        <Style TargetType="TabItem">
            <!-- Without this, tab content falls back to WPF's default black text. -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,4,0" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Label" ContentSource="Header" Margin="14,8" Opacity="0.65"
                                              TextElement.FontSize="14" />
                            <Border x:Name="Underline" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="10,0"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleBarIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,8" SelectionChanged="SettingsTabs_SelectionChanged">
            <TabItem x:Name="GamesTab" Header="Games">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                        <ListBox x:Name="GameList" SelectionChanged="GameList_SelectionChanged" ItemContainerStyle="{StaticResource CellItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowUp20}" ToolTip="Move up" Padding="4"
                                                   Click="MoveProfileUpButton_Click" Tag="{Binding}" />
                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowDown20}" ToolTip="Move down" Padding="4" Margin="2,0,0,0"
                                                   Click="MoveProfileDownButton_Click" Tag="{Binding}" />
                                        <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete20}" ToolTip="Delete game" Padding="4" Margin="2,0,0,0"
                                                   Click="RemoveProfileButton_Click" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:Button Content="Add game" Icon="{ui:SymbolIcon Add20}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="AddProfileButton_Click" />
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=GameList}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Name" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="GameNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Name, StringFormat='Apps launched for {0}, in order'}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,16,0,8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl x:Name="ProfileAppList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="10,4" CornerRadius="4"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"
                                                          IsChecked="{Binding Selected, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowUp20}" ToolTip="Move up" Padding="4"
                                                           IsEnabled="{Binding IsReferenced}" Click="MoveProfileAppUpButton_Click" Tag="{Binding}" />
                                                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowDown20}" ToolTip="Move down" Padding="4" Margin="2,0,0,0"
                                                           IsEnabled="{Binding IsReferenced}" Click="MoveProfileAppDownButton_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="AppsTab" Header="Apps">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                        <ListBox x:Name="AppList" SelectionChanged="AppList_SelectionChanged" ItemContainerStyle="{StaticResource CellItem}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,1" CornerRadius="3" Background="#2E6B45"
                                                Visibility="{Binding UsesSteam, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Steam" FontSize="10" Foreground="White" />
                                        </Border>
                                        <Border Grid.Column="2" Margin="4,0,0,0" Padding="5,1" CornerRadius="3" Background="#5B4A8F"
                                                Visibility="{Binding ShowVrTag, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="VR" FontSize="10" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:Button Content="Add app" Icon="{ui:SymbolIcon Add20}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,2,0,0" Click="AddAppButton_Click" />
                        </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <TextBlock x:Name="NoAppsText" Grid.Column="1" Visibility="Collapsed" Opacity="0.7"
                               Text="No apps yet. Press Add app to set one up." />

                    <ScrollViewer x:Name="AppDetails" Grid.Column="1"
                                  DataContext="{Binding SelectedItem, ElementName=AppList}">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Name" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Process name (used to tell if it's running, no .exe)" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Path" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Path to executable" />
                                <ui:Button Grid.Column="1" Content="Browse" Icon="{ui:SymbolIcon FolderOpen20}" Margin="8,0,0,0"
                                           Click="BrowseButton_Click" Tag="{Binding}" />
                                <ui:Button Grid.Column="2" Content="Auto-Find" Icon="{ui:SymbolIcon Search20}" Margin="8,0,0,0"
                                           IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBooleanConverter}}"
                                           Click="AutoFindButton_Click" Tag="{Binding}" />
                            </Grid>

                            <TextBlock Text="Steam App ID (optional, from the store page URL)" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Content="Find ID" Icon="{ui:SymbolIcon Search20}" Margin="8,0,0,0"
                                           Click="FindSteamIdButton_Click" Tag="{Binding}" />
                                <CheckBox Grid.Column="2" Content="Launch in VR" Margin="8,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding LaunchInVr}" IsEnabled="{Binding UsesSteam}" />
                            </Grid>

                            <TextBlock Text="Launch arguments (optional)" FontSize="11" Opacity="0.7" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding UsesSteam, Converter={StaticResource InverseBooleanConverter}}" />
                            <TextBlock Text="Steam games: set launch options in Steam (Properties &gt; Launch Options)."
                                       FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding UsesSteam, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding FindStatus}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <ui:Button Content="Delete app" Icon="{ui:SymbolIcon Delete20}" Margin="0,16,0,0"
                                       Click="RemoveAppButton_Click" Tag="{Binding}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="GeneralTab" Header="General">
                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Delay between launches (seconds)" FontSize="13" />
                            <TextBlock Text="Time to wait after starting each app before starting the next."
                                       FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:TextBox x:Name="DelayBox" Grid.Column="1" Width="80" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Launch at Windows startup" FontSize="13" />
                                <TextBlock Text="Starts the launcher automatically when you sign in."
                                           FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Close to tray" FontSize="13" />
                                <TextBlock Text="Closing the window hides it to the tray instead of exiting. Use the tray icon's Exit to quit."
                                           FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Theme" FontSize="13" />
                            <TextBlock Text="Switches the launcher between dark and light." FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:ToggleSwitch x:Name="ThemeToggle" OnContent="Dark theme" OffContent="Light theme"
                                      Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <ui:InfoBar x:Name="ValidationInfoBar" Grid.Row="2" Margin="16,0,16,0"
                    IsOpen="False" IsClosable="False" Severity="Warning" Title="Can't save yet" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="Cancel" Margin="0,0,8,0" Click="CancelButton_Click" />
            <ui:Button Content="Save" Click="SaveButton_Click" MinWidth="80" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Background="{StaticResource SelectBlue}" MouseOverBackground="{StaticResource SelectBlueHover}"
                       PressedBackground="{StaticResource SelectBluePressed}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
