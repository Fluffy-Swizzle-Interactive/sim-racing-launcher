<ui:FluentWindow x:Class="iRacingLauncher.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Settings" Height="560" Width="860" MinWidth="760"
                  Icon="pack://application:,,,/Assets/SimRacingLauncher.ico"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleBarIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="16,8">
            <TabItem x:Name="GamesTab" Header="Games">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Each profile has its own selected apps and launch order — switch between them from the main window."
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl x:Name="ProfileEditList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowUp20}" ToolTip="Move up" Margin="8,0,0,0"
                                                       Click="MoveProfileUpButton_Click" Tag="{Binding}" />
                                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowDown20}" ToolTip="Move down" Margin="4,0,0,0"
                                                       Click="MoveProfileDownButton_Click" Tag="{Binding}" />
                                            <ui:Button Grid.Column="3" Content="Edit Apps" Margin="8,0,0,0"
                                                       Click="EditProfileAppsButton_Click" Tag="{Binding}" />
                                            <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Delete20}" ToolTip="Delete profile" Margin="8,0,0,0"
                                                       Click="RemoveProfileButton_Click" Tag="{Binding}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="Add Profile" Icon="Add20" Margin="0,8,0,0" Click="AddProfileButton_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="EditingProfileLabel" Text="Selected for:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl x:Name="ProfileAppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowUp20}" ToolTip="Move up" Margin="8,0,0,0"
                                                       IsEnabled="{Binding IsReferenced}" Click="MoveProfileAppUpButton_Click" Tag="{Binding}" />
                                            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowDown20}" ToolTip="Move down" Margin="4,0,0,0"
                                                       IsEnabled="{Binding IsReferenced}" Click="MoveProfileAppDownButton_Click" Tag="{Binding}" />
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AppsTab" Header="Apps">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Configure each app once here, then enable it per game in Selected Apps above."
                                   FontSize="11" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ItemsControl x:Name="AppEditList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete20}" ToolTip="Remove" Margin="8,0,0,0"
                                                           Click="RemoveAppButton_Click" Tag="{Binding}" />
                                            </Grid>
                                            <ui:TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="Process name (no .exe)" Margin="0,0,0,4" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Path to executable" />
                                                <ui:Button Grid.Column="1" Content="Browse" Icon="{ui:SymbolIcon FolderOpen20}" Margin="8,0,0,0"
                                                           Click="BrowseButton_Click" Tag="{Binding}" />
                                                <ui:Button Grid.Column="2" Content="Auto-Find" Icon="{ui:SymbolIcon Search20}" Margin="8,0,0,0"
                                                           Click="AutoFindButton_Click" Tag="{Binding}" />
                                            </Grid>
                                            <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding UsesSteam, Converter={StaticResource InverseBooleanConverter}}"
                                                     PlaceholderText="Launch arguments (optional)" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:TextBox Grid.Column="0" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Steam App ID (optional, from the store page URL)" />
                                                <ui:Button Grid.Column="1" Content="Find ID" Icon="{ui:SymbolIcon Search20}" Margin="8,0,0,0"
                                                           Click="FindSteamIdButton_Click" Tag="{Binding}" />
                                                <CheckBox Grid.Column="2" Content="Launch in VR" Margin="8,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding LaunchInVr}" IsEnabled="{Binding UsesSteam}" />
                                            </Grid>
                                            <TextBlock Text="Steam games: set launch options in Steam (Properties &gt; Launch Options)."
                                                       FontSize="11" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding UsesSteam, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding FindStatus}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add App" Icon="Add20" Click="AddAppButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GeneralTab" Header="General">
                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Delay between launches (seconds)" FontSize="13" />
                            <TextBlock Text="Time to wait after starting each app before starting the next."
                                       FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:TextBox x:Name="DelayBox" Grid.Column="1" Width="80" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Launch at Windows startup" FontSize="13" />
                                <TextBlock Text="Starts the launcher automatically when you sign in."
                                           FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Close to tray" FontSize="13" />
                                <TextBlock Text="Closing the window hides it to the tray instead of exiting. Use the tray icon's Exit to quit."
                                           FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Theme" FontSize="13" />
                            <TextBlock Text="Switches the launcher between dark and light." FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:ToggleSwitch x:Name="ThemeToggle" OnContent="Dark theme" OffContent="Light theme"
                                      Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <ui:InfoBar x:Name="ValidationInfoBar" Grid.Row="2" Margin="16,0,16,0"
                    IsOpen="False" IsClosable="False" Severity="Warning" Title="Can't save yet" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="Cancel" Margin="0,0,8,0" Click="CancelButton_Click" />
            <ui:Button Content="Save" Appearance="Primary" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
