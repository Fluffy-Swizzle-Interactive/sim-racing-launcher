<UserControl x:Class="iRacingLauncher.Controls.AppRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Margin="0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                      IsChecked="{Binding Selected, Mode=TwoWay}" />

            <Image Grid.Column="1" Width="28" Height="28" Margin="0,0,12,0"
                   Source="{Binding Icon}" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Column="3" Margin="4,0" Icon="{ui:SymbolIcon Play20}" ToolTip="Start"
                       IsEnabled="{Binding IsStartable}"
                       Click="StartButton_Click" />
            <ui:Button Grid.Column="4" Margin="4,0" Icon="{ui:SymbolIcon Stop20}" ToolTip="Stop"
                       IsEnabled="{Binding IsRunning}"
                       Click="StopButton_Click" />
        </Grid>
    </ui:Card>
</UserControl>
