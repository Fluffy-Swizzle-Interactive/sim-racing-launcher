<UserControl x:Class="iRacingLauncher.Controls.AppRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Margin="0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                      IsChecked="{Binding Selected, Mode=TwoWay}" />

            <Image Grid.Column="1" Width="28" Height="28" Margin="0,0,12,0"
                   Source="{Binding Icon}" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                <Border Background="{Binding StatusColor}" CornerRadius="8" Padding="8,1"
                        HorizontalAlignment="Left" Margin="0,2,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                </Border>
            </StackPanel>

            <ui:Button Grid.Column="3" Content="Start" Margin="4,0" Icon="Play20"
                       IsEnabled="{Binding IsStartable}"
                       Click="StartButton_Click" />
            <ui:Button Grid.Column="4" Content="Stop" Margin="4,0" Icon="Stop20"
                       IsEnabled="{Binding IsRunning}"
                       Click="StopButton_Click" />
        </Grid>
    </ui:Card>
</UserControl>
